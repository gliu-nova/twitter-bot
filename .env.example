# FRED API key (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Coinglass API key (optional, free hobbyist tier): https://www.coinglass.com/pricing
# Enables full hourly liquidation backfill in market-memory.
COINGLASS_API_KEY=

# Coinalyze API key (free): https://coinalyze.net/account/api-key/
# Cross-verifies OKX/Binance liquidation spikes in market-memory sync/backfill.
COINALYZE_API_KEY=

# Etherscan API (on-chain whales, gas, volume spikes via market-memory.etherscan)
# https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=
# Optional overrides:
# ETHERSCAN_DB_PATH=../market-memory/data/etherscan.db
# ETHERSCAN_WATCHLIST_PATH=data/etherscan_watchlist.yaml
# ETHERSCAN_CHAIN=ethereum

# Blockscout API (on-chain whales + high-EV trader scores via market-memory.blockscout)
# https://docs.blockscout.com/
BLOCKSCOUT_API_KEY=
# Optional overrides:
# BLOCKSCOUT_DB_PATH=../market-memory/data/blockscout.db
# BLOCKSCOUT_INSTANCE=ethereum
# BLOCKSCOUT_WATCHLIST_PATH=data/etherscan_watchlist.yaml

# Twitter/X API (https://developer.x.com/)
TWITTER_API_KEY=
TWITTER_API_SECRET=
# Required to POST tweets (generate under Keys and tokens → Access Token and Secret):
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Ops dashboard (optional): unified status at https://ops-hub-8ek.pages.dev
# OPS_HUB_URL=https://ops-hub-8ek.pages.dev
# OPS_HEARTBEAT_SECRET=

# Set to 1 to print tweets instead of posting
DRY_RUN=1